# Values for $(env.NAME) reads in the configuration file.
#
# Place this beside the configuration, as ~/.config/leme/leme.env. Leme looks
# for it in the same directory as the config file it is loading, and an absent
# file is not an error.
#
# One use is giving a single configuration a per-machine value, so the same
# config.scfg can be shared across several machines:
#
#     vars { profile $(env.LEME_PROFILE) }
#     if $profile == "desktop" {
#         output "DP-1" { mode 1920x1080 }
#     } else {
#         output "eDP-1" { scale 1.25 }
#     }
#
# The process environment wins over this file, so a value can be overridden for
# a single run without editing anything:
#
#     LEME_PROFILE=laptop leme --config-check
#
# The file is re-read by reload_config, so changing a value here does not
# require a new session.
#
# Values are taken literally. Quotes are kept as part of the value, $ is not
# expanded, and `export NAME=value` is rejected. An empty value counts as unset.

LEME_PROFILE=desktop
PRIMARY_OUTPUT=DP-1
