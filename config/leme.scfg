tags {
    initial 3
    maximum 9
    layout dwindle
}

keyboard {
    layout us
}

vars {
    mod SUPER
    term foot
}

binds "common" {
    $mod+Return spawn $term
    $mod+q close_view

    for i in 1..3 {
        $mod+$i focus_tag $i
        $mod+SHIFT+$i move_view_to_tag $i
    }

    $mod+r reload_config
    $mod+SHIFT+e quit
}
